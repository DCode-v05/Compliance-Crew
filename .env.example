# Copy this file to .env and fill in your API key.
# Groq offers a free tier sufficient for development and demo.

# Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model
GROQ_MODEL=llama-3.3-70b-versatile

# Demo mode: when true, the Mapper's first attempt uses a slightly weakened
# prompt to reliably trigger a Validator rejection on the demo paragraph. The
# retry uses the full prompt and reliably succeeds. Stagecraft for the demo.
DEMO_MODE=false
